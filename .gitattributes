# Parser test inputs must reach the parser byte for byte on every OS.
/crates/workflint-yaml/tests/yaml-test-suite/** -text

# The reference's output fixtures are compared byte for byte, so Windows checkouts must keep `\n`.
/crates/workflint-diagnostics/tests/actionlint/** -text

# The vendored reference test data must stay byte-identical to upstream, which marks it the same way.
/tests/conformance/actionlint/** -text

# The YAML parity inputs test BOMs and line breaks, so they must reach both parsers byte for byte.
/tests/yaml-parity/** -text

# Fuzz regression inputs must reach the checks byte for byte, like the crash inputs they come from.
/crates/workflint-yaml/tests/fuzz-regressions/** -text

# Expression parity cases are compared with their spaces and positions, so they must reach both checkers byte for byte.
/tests/expr-parity/** -text
