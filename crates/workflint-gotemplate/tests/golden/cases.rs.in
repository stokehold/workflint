        data: Data::Misc,
        template: "{{slice .map 0}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <slice .map 0>: error calling slice: can't slice item of type map[string]interface {}"),
    },
    Case {
        name: "slice_out_of_range",
        data: Data::Misc,
        template: "{{slice .strs 0 4}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <slice .strs 0 4>: error calling slice: index out of range: 4"),
    },
    Case {
        name: "print",
        data: Data::Misc,
        template: "{{print}}|{{print 1 2}}|{{print \"a\" \"b\"}}|{{print 1 \"a\" 2}}|{{print .list .nil}}|{{print .missing}}",
        want: Want::Output("|1 2|ab|1a2|[a 1 true <nil>] <nil>|<nil>"),
    },
    Case {
        name: "println",
        data: Data::Misc,
        template: "{{println}}|{{println 1 \"a\" .t}}|",
        want: Want::Output("\n|1 a true\n|"),
    },
    Case {
        name: "html",
        data: Data::Misc,
        template: "{{html .html}} {{html 1 \"<\"}} {{.html | html}}",
        want: Want::Output("&lt;a href=&#34;x&#34;&gt;&amp;&#39;&lt;/a&gt;\u{fffd} 1&lt; &lt;a href=&#34;x&#34;&gt;&amp;&#39;&lt;/a&gt;\u{fffd}"),
    },
    Case {
        name: "js",
        data: Data::Misc,
        template: "{{js .js}} {{js .ctrl}}",
        want: Want::Output("it\\'s \\u003Cb\\u003E \\u0026 \\\"q\\\" \\u003D \\\\ \\u2028 \\u0001 é tab\\u0009here\\u000Anl\\u0000\\u0007\u{7f}\\u000D"),
    },
    Case {
        name: "urlquery",
        data: Data::Misc,
        template: "{{urlquery .url}} {{urlquery 1 2}}",
        want: Want::Output("a+b%26c%3Dd%2F%C3%A9%3F~_-. 1+2"),
    },
    Case {
        name: "eq",
        data: Data::Misc,
        template: "{{eq 1 1}} {{eq 1 2}} {{eq \"a\" \"a\"}} {{eq .int 42}} {{eq 1 2 3 1}} {{eq .nil .nil}} {{eq .t true}} {{eq 1.5 1.5}}",
        want: Want::Output("true false true true true true true true"),
    },
    Case {
        name: "eq_incompatible",
        data: Data::Misc,
        template: "{{eq 1 \"1\"}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <eq 1 \"1\">: error calling eq: incompatible types for comparison: int and string"),
    },
    Case {
        name: "eq_int_float",
        data: Data::Misc,
        template: "{{eq 1 1.0}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <eq 1 1.0>: error calling eq: incompatible types for comparison: int and float64"),
    },
    Case {
        name: "eq_missing_arg",
        data: Data::Nil,
        template: "{{eq 1}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <eq 1>: error calling eq: missing argument for comparison"),
    },
    Case {
        name: "eq_lists",
        data: Data::Misc,
        template: "{{eq .list .list}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <eq .list .list>: error calling eq: non-comparable type [a %!s(int=1) %!s(bool=true) <nil>]: []interface {}"),
    },
    Case {
        name: "eq_nil_and_list",
        data: Data::Misc,
        template: "{{eq .nil .list}}",
        want: Want::Output("false"),
    },
    Case {
        name: "ne",
        data: Data::Misc,
        template: "{{ne 1 2}} {{ne \"a\" \"a\"}}",
        want: Want::Output("true false"),
    },
    Case {
        name: "lt_le_gt_ge",
        data: Data::Nil,
        template: "{{lt 1 2}} {{le 2 2}} {{gt 1 2}} {{ge 2 2}} {{lt \"a\" \"b\"}} {{lt 1.5 2.5}} {{gt \"b\" \"a\"}}",
        want: Want::Output("true true false true true true true"),
    },
    Case {
        name: "lt_bool",
        data: Data::Nil,
        template: "{{lt true false}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <lt true false>: error calling lt: invalid type for comparison"),
    },
    Case {
        name: "lt_incompatible",
        data: Data::Nil,
        template: "{{lt 1 \"a\"}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <lt 1 \"a\">: error calling lt: incompatible types for comparison: int and string"),
    },
    Case {
        name: "lt_list",
        data: Data::Misc,
        template: "{{lt .list 1}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <lt .list 1>: error calling lt: invalid type for comparison"),
    },
    Case {
        name: "lt_wrong_args",
        data: Data::Nil,
        template: "{{lt 1}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <lt>: wrong number of args for lt: want 2 got 1"),
    },
    Case {
        name: "call_non_function",
        data: Data::Misc,
        template: "{{call .str}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <call .str>: error calling call: non-function .str of type string"),
    },
    Case {
        name: "call_nil",
        data: Data::Misc,
        template: "{{call .nil}}",
        want: Want::ExecError("", "template: error formatter:1:2: executing \"error formatter\" at <call .nil>: error calling call: call of nil"),
    },
    Case {
        name: "printf_q_strings",
        data: Data::Misc,
        template: "{{printf \"%q\" .str}} {{printf \"%q\" .ctrl}} {{printf \"%q\" .uni}} {{printf \"%q\" .quote}}",
        want: Want::Output("\"héllo\" \"tab\\there\\nnl\\x00\\a\\x7f\\r\" \"日本語 é \\u200b \\u00ad 😀 \\u2028\" \"say \\\"hi\\\" \\\\ back`\""),
    },
    Case {
        name: "printf_q_flags",
        data: Data::Misc,
        template: "{{printf \"%+q\" .uni}} {{printf \"%#q\" .str}} {{printf \"%#q\" .quote}} {{printf \"%#+q\" .uni}}",
        want: Want::Output("\"\\u65e5\\u672c\\u8a9e \\u00e9 \\u200b \\u00ad \\U0001f600 \\u2028\" `héllo` \"say \\\"hi\\\" \\\\ back`\" `日本語 é \u{200b} \u{ad} 😀 \u{2028}`"),
    },
    Case {
        name: "printf_q_other",
        data: Data::Misc,
        template: "{{printf \"%q\" 65}} {{printf \"%q\" .strs}} {{printf \"%q\" .t}} {{printf \"%q\" .map}}",
        want: Want::Output("'A' [\"x\" \"y\" \"z\"] %!q(bool=true) map[\"a\":'\\x01' \"b\":'\\x02' \"c\":\"three\"]"),
    },
    Case {
        name: "printf_v",
        data: Data::Misc,
        template: "{{printf \"%v|%v|%v|%v|%v|%v|%v\" .str .int .float .t .nil .list .map}}",
        want: Want::Output("héllo|42|3.5|true|<nil>|[a 1 true <nil>]|map[a:1 b:2 c:three]"),
    },
    Case {
        name: "printf_plus_v",
        data: Data::Misc,
        template: "{{printf \"%+v\" .one}} {{printf \"%#v\" .str}} {{printf \"%#v\" .int}}",
        want: Want::Output("&{Message:m Filepath:f Line:1 Column:2 Kind:k Snippet:s EndColumn:3} \"héllo\" 42"),
    },
    Case {
        name: "printf_d",
        data: Data::Misc,
        template: "{{printf \"%d %5d %-5d| %05d %+d %x %X %o %b %c %U\" .int .int .int .neg .int 255 255 8 5 65 233}}",
        want: Want::Output("42    42 42   | -0007 +42 ff FF 10 101 A U+00E9"),
    },
    Case {
        name: "printf_s",
        data: Data::Misc,
        template: "{{printf \"%s|%10s|%-10s|%.2s|%x|% x|%X\" .str .str .str .str \"hi\" \"hi\" \"hi\"}}",
        want: Want::Output("héllo|     héllo|héllo     |hé|6869|68 69|6869"),
    },
    Case {
        name: "printf_f",
        data: Data::Misc,
        template: "{{printf \"%f %.2f %8.3f %e %g %G %.3g %E\" .float .float .float .big .small .big .float 1234.5678}}",
        want: Want::Output("3.500000 3.50    3.500 1.000000e+21 1e-05 1E+21 3.5 1.234568E+03"),
    },
    Case {
        name: "printf_t",
        data: Data::Misc,
        template: "{{printf \"%t %t\" .t .f}}",
        want: Want::Output("true false"),
    },
    Case {
        name: "printf_percent",
        data: Data::Nil,
        template: "{{printf \"100%%\"}}",
        want: Want::Output("100%"),
    },
    Case {
        name: "printf_bad_verb",
        data: Data::Misc,
        template: "{{printf \"%z %d\" .str .str}}",
        want: Want::Output("%!z(string=héllo) %!d(string=héllo)"),
    },
    Case {
        name: "printf_missing",
        data: Data::Nil,
        template: "{{printf \"%d %s\" 1}}",
        want: Want::Output("1 %!s(MISSING)"),
    },
    Case {
        name: "printf_extra",
        data: Data::Nil,
        template: "{{printf \"%d\" 1 \"a\" true}}",
        want: Want::Output("1%!(EXTRA string=a, bool=true)"),
    },
    Case {
        name: "printf_nil",
        data: Data::Misc,
        template: "{{printf \"%v %s %d\" .nil .nil .nil}}",
        want: Want::Output("<nil> %!s(<nil>) %!d(<nil>)"),
    },
    Case {
        name: "printf_lists",
        data: Data::Misc,
        template: "{{printf \"%d %s %v %x\" .ints .strs .list .strs}}",
        want: Want::Output("[3 1 2] [x y z] [a 1 true <nil>] [78 79 7a]"),
    },
    Case {
        name: "printf_no_verbs",
        data: Data::Nil,
        template: "{{printf \"plain\"}}",
        want: Want::Output("plain"),
    },
    Case {
        name: "printf_trailing_percent",
        data: Data::Nil,
        template: "{{printf \"a%\"}}",
        want: Want::Output("a%!(NOVERB)"),
    },
    Case {
        name: "printf_star_width",
        data: Data::Nil,
        template: "{{printf \"%*d|%-*d|%.*f\" 5 1 3 2 1 3.14159}}",
        want: Want::Output("    1|2  |3.1"),
    },
    Case {
        name: "printf_arg_index",
        data: Data::Nil,
        template: "{{printf \"%[2]d %[1]d %d\" 1 2}}",
        want: Want::Output("2 1 2"),
    },
    Case {
        name: "printf_format_not_string",
        data: Data::Nil,
        template: "{{printf 1}}",
        want: Want::ExecError("", "template: error formatter:1:9: executing \"error formatter\" at <1>: expected string; found 1"),
    },
    Case {
        name: "printf_format_from_field",
        data: Data::Misc,
        template: "{{printf .int}}",
        want: Want::ExecError("", "template: error formatter:1:9: executing \"error formatter\" at <.int>: wrong type for value; expected string; got int"),
    },
    Case {
        name: "printf_width_on_q",
        data: Data::Misc,
        template: "{{printf \"%12q|%-12q|\" \"a\" \"b\"}}",
        want: Want::Output("         \"a\"|\"b\"         |"),
    },
    Case {
        name: "printf_float_specials",
        data: Data::Nil,
        template: "{{printf \"%v %.1f %5.1f %-8.2e|\" 0.1 0.05 -2.25 123456.0}}",
        want: Want::Output("0.1 0.1  -2.2 1.23e+05|"),
    },
    Case {
        name: "printf_x_negative",
        data: Data::Nil,
        template: "{{printf \"%x %#x %#o %#b %08.3f %+.2e\" -255 255 8 5 3.14159 12345.678}}",
        want: Want::Output("-ff 0xff 010 0b101 0003.142 +1.23e+04"),
    },
    Case {
        name: "printf_string_precision_unicode",
        data: Data::Misc,
        template: "{{printf \"%.3s|%5.1s|\" .uni .uni}}",
        want: Want::Output("日本語|    日|"),
    },
    Case {
        name: "printf_c_and_U",
        data: Data::Nil,
        template: "{{printf \"%c%c %U %#U\" 26085 0x1F600 0x1F600 0x41}}",
        want: Want::Output("日😀 U+1F600 U+0041 'A'"),
    },
    Case {
        name: "printf_q_int_invalid_rune",
        data: Data::Nil,
        template: "{{printf \"%q %+q\" -1 0x1F600}}",
        want: Want::Output("'\u{fffd}' '\\U0001f600'"),
    },
    Case {
        name: "printf_s_struct",
        data: Data::Misc,
        template: "{{printf \"%s|%d\" .one .one}}",
        want: Want::Output("&{m f %!s(int=1) %!s(int=2) k s %!s(int=3)}|&{%!d(string=m) %!d(string=f) 1 2 %!d(string=k) %!d(string=s) 3}"),
    },
    Case {
        name: "printf_v_nested_map",
        data: Data::Misc,
        template: "{{printf \"%v %+v\" .nested .maps}}",
        want: Want::Output("map[inner:map[x:deep]] [map[k:1] map[k:2]]"),
    },
    Case {
        name: "printf_v_mixed",
        data: Data::Misc,
        template: "{{printf \"%v %d %s\" .mixed .mixed .mixed}}",
        want: Want::Output("[1 1 1] [1 %!d(string=1) %!d(float64=1)] [%!s(int=1) 1 %!s(float64=1)]"),
    },
    Case {
        name: "printf_sharp_v_list",
        data: Data::Misc,
        template: "{{printf \"%#v\" .strs}}",
        want: Want::Output("[]string{\"x\", \"y\", \"z\"}"),
    },
    Case {
        name: "printf_space_flag",
        data: Data::Nil,
        template: "{{printf \"% d|% d|%+ d\" 5 -5 5}}",
        want: Want::Output(" 5|-5|+5"),
    },
]
